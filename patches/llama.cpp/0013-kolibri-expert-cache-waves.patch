+        fake f(1, 18);
+        auto c = make(f, 48, 4);
+        const auto ids = wave_ids(12, k, 3, 13);
+        CHECK(run_waves(f, *c, 0, ids, k, cap, built, built) == 3);
+        const auto p = c->counts(false);
+        CHECK(p.waves == 3 && p.waves_built == 4);
+    }
