+int llama_expert_wave_cap(int n_slots, int k) {
+    return k > 0 && n_slots >= 3*k ? (n_slots - k)/2 : 0;
+}
+
+int llama_expert_wave_count(int n_touch, int n_slots, int k) {
+    return n_slots > k ? (n_touch + (n_slots - k) - 1)/(n_slots - k) : 0;
+}
