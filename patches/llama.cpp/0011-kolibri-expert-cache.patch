diff --git a/src/llama-expert-cache.cpp b/src/llama-expert-cache.cpp
new file mode 100644
index 000000000..2a328401d
--- /dev/null
+++ b/src/llama-expert-cache.cpp
@@ -0,0 +1,427 @@
+#include "llama-expert-cache.h"
+
+#include "llama-impl.h"
+
+#include "ggml-alloc.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+#include <fstream>
+#include <stdexcept>
+
+#if defined(__APPLE__)
+#include <fcntl.h>
+#include <libproc.h>
+#include <sys/mman.h>
+#include <sys/param.h>
+#include <sys/resource.h>
+#include <unistd.h>
+#elif defined(__linux__)
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/resource.h>
+#include <unistd.h>
+#endif
+
+namespace {
+
+// the counters this platform measures; the others are reported as null
+struct process_counts {
+    uint64_t disk_read = 0;
+    uint64_t pageins   = 0;
+    uint64_t faults    = 0;
+    uint64_t max_phys_footprint = 0;
+#if defined(__APPLE__)
+    static constexpr bool has_io     = true; // disk_read, pageins, max_phys_footprint
+#else
+    static constexpr bool has_io     = false;
+#endif
+#if defined(__APPLE__) || defined(__linux__)
+    static constexpr bool has_faults = true;
+#else
+    static constexpr bool has_faults = false;
+#endif
+};
+
+std::string json_u64(bool measured, uint64_t v) {
+    return measured ? std::to_string(v) : std::string("null");
+}
+
+// s as a JSON string, quotes included
+std::string json_string(const std::string & s) {
+    std::string out = "\"";
+    for (const unsigned char c : s) {
+        switch (c) {
+            case '"':  out += "\\\""; break;
+            case '\\': out += "\\\\"; break;
+            case '\n': out += "\\n"; break;
+            case '\r': out += "\\r"; break;
+            case '\t': out += "\\t"; break;
+            default:
+                if (c < 0x20) {
+                    out += format("\\u%04x", c);
+                } else {
+                    out += (char) c;
+                }
+        }
+    }
+    return out + "\"";
+}
+
+process_counts process_now() {
+    process_counts c;
+#if defined(__APPLE__)
+    rusage_info_v4 ri = {};
+    if (proc_pid_rusage(getpid(), RUSAGE_INFO_V4, (rusage_info_t *) &ri) == 0) {
+        c.disk_read          = ri.ri_diskio_bytesread;
+        c.pageins            = ri.ri_pageins;
+        c.max_phys_footprint = ri.ri_lifetime_max_phys_footprint;
+    }
+#endif
+#if defined(__APPLE__) || defined(__linux__)
+    rusage ru = {};
+    if (getrusage(RUSAGE_SELF, &ru) == 0) {
+        c.faults = ru.ru_majflt;
+    }
+#endif
+    return c;
+}
+
+void remap_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+    auto * ud = (llama_expert_cache::layer_ud *) userdata;
+    ud->cache->remap(ud->il, dst->src[0], dst);
+}
+
+std::string counts_json(const llama_expert_cache_counts & c) {
+    return format(
+        "{\"steps\": %llu, \"needed\": %llu, \"hits\": %llu, \"hits_loading\": %llu, \"misses\": %llu, "
+        "\"evictions\": %llu, \"demand_bytes\": %llu, \"prefetch_bytes\": %llu, \"prefetch_issued\": %llu, "
+        "\"prefetch_used\": %llu, \"prefetch_wasted\": %llu, \"prefetch_cancelled\": %llu, "
+        "\"prefetch_skipped\": %llu, \"load_failures\": %llu, \"wait_seconds\": %.6f, \"io_seconds\": %.6f, "
+        "\"io_prefetch_seconds\": %.6f}",
+        (unsigned long long) c.steps, (unsigned long long) c.needed, (unsigned long long) c.hits,
+        (unsigned long long) c.hits_loading, (unsigned long long) c.misses, (unsigned long long) c.evictions,
+        (unsigned long long) c.demand_bytes, (unsigned long long) c.prefetch_bytes,
+        (unsigned long long) c.prefetch_issued, (unsigned long long) c.prefetch_used,
+        (unsigned long long) c.prefetch_wasted, (unsigned long long) c.prefetch_cancelled,
+        (unsigned long long) c.prefetch_skipped, (unsigned long long) c.load_failures, c.wait_seconds, c.io_seconds,
+        c.io_prefetch_seconds);
+}
+
+} // namespace
+
+llama_expert_cache::llama_expert_cache(const llama_expert_cache_params & p, int n_layer, int n_expert, int n_expert_used)
+    : n_layer(n_layer), n_expert(n_expert), n_expert_used(n_expert_used),
+      n_threads(std::max(p.n_threads, 1)), prefetch_k(std::max(p.prefetch_k, 0)),
+      prefetch_half_life(std::max(p.prefetch_half_life, 1)), prefetch_mix(p.prefetch_mix),
+      stats_path(p.stats_path ? p.stats_path : "") {
+    if (p.n_slots_layer && p.n_layer_slots > 0) {
+        if (p.n_layer_slots != n_layer) {
+            throw std::runtime_error(format("expert cache: %d per-layer slot counts for %d layers", p.n_layer_slots, n_layer));
+        }
+        n_slots.assign(p.n_slots_layer, p.n_slots_layer + n_layer);
+    } else {
+        n_slots.assign(n_layer, p.n_slots);
+    }
+    for (int & s : n_slots) {
+        if (s < n_expert_used) {
+            throw std::runtime_error(format("expert cache: %d slots per layer, at least %d needed (the experts of one token)", s, n_expert_used));
+        }
+        s = std::min(s, n_expert);
+    }
+    if (prefetch_mix < 0 || prefetch_mix > 1) {
+        throw std::runtime_error(format("expert cache: prefetch mix %g, want [0, 1]", prefetch_mix));
+    }
+}
+
+llama_expert_cache::~llama_expert_cache() {
+    // the I/O threads go first: they write into the slots and read the file
+    if (slots) {
+        slots->drain();
+    }
+    const std::string stats = slots ? stats_json() : "";
+    slots.reset();
+    if (!stats.empty()) {
+        LLAMA_LOG_INFO("%s: %s\n", __func__, stats.c_str());
+        if (!stats_path.empty()) {
+            std::ofstream out(stats_path);
+            out << stats << "\n";
+            if (!out) {
+                LLAMA_LOG_ERROR("%s: cannot write %s\n", __func__, stats_path.c_str());
+            }
+        }
+    }
+#if defined(__APPLE__) || defined(__linux__)
+    if (fd >= 0) {
+        close(fd);
+    }
+#endif
+    for (auto & gr : groups) {
+        if (gr.buf) {
+            ggml_backend_buffer_free(gr.buf);
+        }
+#if defined(__APPLE__) || defined(__linux__)
+        if (gr.host) {
+            munmap(gr.host, gr.size);
+        }
+#endif
+        if (gr.ctx) {
+            ggml_free(gr.ctx);
+        }
+    }
+}
+
+size_t llama_expert_cache::slot_bytes() const {
+    size_t n = 0;
+    for (const auto & gr : groups) {
+        n += gr.buf ? ggml_backend_buffer_get_size(gr.buf) : 0;
+    }
+    return n;
+}
+
+void llama_expert_cache::init(const std::vector<tensors> & stacked_in, const std::vector<ggml_backend_dev_t> & devs, int fd_loader) {
+    GGML_ASSERT((int) stacked_in.size() == n_layer && (int) devs.size() == n_layer);
+    stacked = stacked_in;
+
+    // one group of slot tensors per device: the stacked tensors' first two dimensions, n_slots experts
+    std::vector<int> group_of(n_layer);
+    for (int il = 0; il < n_layer; ++il) {
+        int g = 0;
+        while (g < (int) groups.size() && groups[g].dev != devs[il]) {
+            g++;
+        }
+        if (g == (int) groups.size()) {
+            groups.push_back({});
+            groups[g].dev = devs[il];
+        }
+        group_of[il] = g;
+    }
+    for (auto & gr : groups) {
+        ggml_init_params ip = {
+            /*.mem_size   =*/ ggml_tensor_overhead()*3*n_layer,
+            /*.mem_buffer =*/ nullptr,
+            /*.no_alloc   =*/ true,
+        };
+        gr.ctx = ggml_init(ip);
+        if (!gr.ctx) {
+            throw std::runtime_error("expert cache: ggml_init failed");
+        }
+    }
+    static const char * names[3] = { "ffn_gate_exps_slots", "ffn_up_exps_slots", "ffn_down_exps_slots" };
+    slot_t.resize(n_layer);
+    expert_bytes.resize(n_layer);
+    for (int il = 0; il < n_layer; ++il) {
+        size_t bytes = 0;
+        for (int k = 0; k < 3; ++k) {
+            const ggml_tensor * s = stacked[il].t[k];
+            if (!s || s->ne[2] != n_expert || !ggml_is_contiguous(s)) {
+                throw std::runtime_error(format("expert cache: layer %d has no contiguous stacked tensor %s of %d experts", il, names[k], n_expert));
+            }
+            ggml_tensor * t = ggml_new_tensor_3d(groups[group_of[il]].ctx, s->type, s->ne[0], s->ne[1], n_slots[il]);
+            ggml_format_name(t, "blk.%d.%s", il, names[k]);
+            GGML_ASSERT(t->nb[2] == s->nb[2]);
+            slot_t[il].t[k] = t;
+            bytes += s->nb[2];
+        }
+        expert_bytes[il] = bytes;
+    }
+
+    for (auto & gr : groups) {
+        const char * dev_name = ggml_backend_dev_name(gr.dev);
+        if (ggml_backend_dev_type(gr.dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            // the device's own buffer type is plain host memory, unlike the repacking extra types
+            gr.buf = ggml_backend_alloc_ctx_tensors_from_buft(gr.ctx, ggml_backend_dev_buffer_type(gr.dev));
+        } else {
+#if defined(__APPLE__) || defined(__linux__)
+            ggml_backend_dev_props props;
+            ggml_backend_dev_get_props(gr.dev, &props);
+            if (!props.caps.buffer_from_host_ptr) {
+                throw std::runtime_error(format("expert cache: %s cannot use host memory for the slots (no buffer_from_host_ptr); "
+                    "the cache needs the expert layers on the CPU or on a device that can, such as Metal", dev_name));
+            }
+            // host memory the device uses in place: the I/O threads read into it, nothing is copied;
+            // an anonymous mapping, so slots never written cost no memory
+            const size_t align = (size_t) std::max(sysconf(_SC_PAGESIZE), 4096L); // also covers the buffer's own alignment
+            size_t max_tensor = 0;
+            for (ggml_tensor * t = ggml_get_first_tensor(gr.ctx); t; t = ggml_get_next_tensor(gr.ctx, t)) {
+                gr.size += GGML_PAD(ggml_nbytes(t), align);
+                max_tensor = std::max(max_tensor, ggml_nbytes(t));
+            }
+            gr.host = mmap(nullptr, gr.size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+            if (gr.host == MAP_FAILED) {
+                gr.host = nullptr;
+                throw std::runtime_error(format("expert cache: cannot map %zu bytes for the slots: %s", gr.size, strerror(errno)));
+            }
+            gr.buf = ggml_backend_dev_buffer_from_host_ptr(gr.dev, gr.host, gr.size, max_tensor);
+            if (gr.buf) {
+                ggml_tallocr ta = ggml_tallocr_new(gr.buf);
+                for (ggml_tensor * t = ggml_get_first_tensor(gr.ctx); t; t = ggml_get_next_tensor(gr.ctx, t)) {
+                    if (ggml_tallocr_alloc(&ta, t) != GGML_STATUS_SUCCESS) {
+                        throw std::runtime_error(format("expert cache: cannot place %s in the slot buffer of %s", ggml_get_name(t), dev_name));
+                    }
+                }
+            }
+#else
+            throw std::runtime_error(format("expert cache: the slots of %s need host memory the device can use, not supported on this platform", dev_name));
+#endif
+        }
+        if (!gr.buf) {
+            throw std::runtime_error(format("expert cache: cannot allocate the slots for %s", dev_name));
+        }
+        // the slots hold weights: the scheduler runs the expert matmuls where they are
+        ggml_backend_buffer_set_usage(gr.buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    }
+
+#if defined(__APPLE__)
+    char p[MAXPATHLEN];
+    if (fcntl(fd_loader, F_GETPATH, p) == -1) {
+        throw std::runtime_error(format("expert cache: F_GETPATH: %s", strerror(errno)));
+    }
+    path = p;
+    fd = open(p, O_RDONLY);
+    if (fd < 0) {
+        throw std::runtime_error(format("expert cache: open %s: %s", p, strerror(errno)));
+    }
+    // reads go to the device, not through the page cache
+    fcntl(fd, F_NOCACHE, 1);
+#elif defined(__linux__)
+    path = format("/proc/self/fd/%d", fd_loader);
+    fd = open(path.c_str(), O_RDONLY);
+    if (fd < 0) {
+        throw std::runtime_error(format("expert cache: open %s: %s", path.c_str(), strerror(errno)));
+    }
+#else
+    GGML_UNUSED(fd_loader);
+    throw std::runtime_error("expert cache: not supported on this platform");
+#endif
+
+    ud.resize(n_layer);
+    for (int il = 0; il < n_layer; ++il) {
+        ud[il] = { this, il };
+    }
+    slots = std::make_unique<llama_expert_slots>(n_slots, n_expert, expert_bytes, n_threads,
+        [this](int il, int e, int s) { return load(il, e, s); });
+    if (prefetch_k > 0) {
+        markov = std::make_unique<llama_expert_markov>(n_layer, n_expert, prefetch_half_life, prefetch_mix);
+    }
+
+    const auto pc = process_now();
+    disk_read0 = pc.disk_read;
+    pageins0   = pc.pageins;
+    faults0    = pc.faults;
+
+    const std::string pf = markov
+        ? format("markov same-token k %d, half-life %d, mix %g (%.1f MiB)", prefetch_k, prefetch_half_life, prefetch_mix, markov->bytes()/1024.0/1024.0)
+        : std::string("off");
+    std::string where;
+    for (const auto & gr : groups) {
+        where += format("%s%.2f MiB for %s", where.empty() ? "" : ", ", ggml_backend_buffer_get_size(gr.buf)/1024.0/1024.0, ggml_backend_dev_name(gr.dev));
+    }
+    LLAMA_LOG_INFO("%s: %d to %d slots per layer of %d experts, %s, %d I/O threads, prefetch %s, reading %s\n",
+        __func__, *std::min_element(n_slots.begin(), n_slots.end()), *std::max_element(n_slots.begin(), n_slots.end()),
+        n_expert, where.c_str(), n_threads, pf.c_str(), path.c_str());
+}
+
+uint32_t llama_expert_cache::max_ubatch() const {
+    return std::max(1, *std::min_element(n_slots.begin(), n_slots.end()) / n_expert_used);
+}
+
+bool llama_expert_cache::attach() {
+    return !attached.exchange(true);
+}
+
+void llama_expert_cache::detach() {
+    attached = false;
+}
+
+ggml_tensor * llama_expert_cache::build_remap(ggml_context * ctx0, ggml_tensor * selected_experts, int il) {
+    ggml_tensor * ids = ggml_cont(ctx0, selected_experts); // [n_expert_used, n_tokens]
+    ggml_format_name(ids, "ffn_moe_topk_cont-%d", il);
+    ggml_tensor * args[1] = { ids };
+    ggml_tensor * out = ggml_custom_4d(ctx0, GGML_TYPE_I32, ids->ne[0], ids->ne[1], 1, 1, args, 1, remap_op, 1, &ud[il]);
+    ggml_format_name(out, "ffn_moe_slots-%d", il);
+    return out;
+}
+
+void llama_expert_cache::remap(int il, const ggml_tensor * ids, ggml_tensor * dst) {
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && dst->type == GGML_TYPE_I32 && ggml_is_contiguous(ids));
+    const int n_tokens = (int) ids->ne[1];
+
+    // a graph runs its layers in order; layer 0 starts the next ubatch (the last layer may see
+    // fewer tokens, only the outputs)
+    if (il == 0) {
+        tok_first = tok_next;
+        tok_next += n_tokens;
+        decode    = n_tokens == 1;
+    }
+
+    if (!slots->remap(il, (const int32_t *) ids->data, (int) ggml_nelements(ids), decode, (int32_t *) dst->data)) {
+        int l = -1;
+        int e = -1;
+        if (slots->failure(l, e)) {
+            GGML_ABORT("expert cache: reading expert %d of layer %d from %s failed", e, l, path.c_str());
+        }
+        GGML_ABORT("expert cache: layer %d needs more distinct experts in one ubatch of %d tokens than its %d slots",
+            il, n_tokens, n_slots[il]);
+    }
+
+    if (markov) {
+        const auto & needed = slots->last_needed();
+        markov->observe(il, tok_first, decode, needed.data(), (int) needed.size());
+        const int target = markov->predict(il + 1, tok_first, decode, prefetch_k, pred);
+        if (target >= 0) {
+            slots->prefetch(target, pred.data(), (int) pred.size(), decode);
+        }
+    }
+}
+
+bool llama_expert_cache::load(int il, int e, int s) {
+#if defined(__APPLE__) || defined(__linux__)
+    for (int k = 0; k < 3; ++k) {
+        const ggml_tensor * t = slot_t[il].t[k];
+        const size_t n   = t->nb[2];
+        char *       dst = (char *) t->data + (size_t) s*n;
+        const off_t  off = (off_t) (stacked[il].offs[k] + (size_t) e*n);
+        size_t done = 0;
+        while (done < n) {
+            const ssize_t r = pread(fd, dst + done, n - done, off + (off_t) done);
+            if (r <= 0) {
+                if (r < 0 && errno == EINTR) {
+                    continue;
+                }
+                LLAMA_LOG_ERROR("%s: pread of %zu bytes at %lld in %s: %s\n", __func__, n - done,
+                    (long long) (off + (off_t) done), path.c_str(), r < 0 ? strerror(errno) : "end of file");
+                return false;
+            }
+            done += (size_t) r;
+        }
+    }
+    return true;
+#else
+    GGML_UNUSED(il);
+    GGML_UNUSED(e);
+    GGML_UNUSED(s);
+    return false;
+#endif
+}
+
+std::string llama_expert_cache::stats_json() const {
+    const auto pc = process_now();
+    const int s_min = *std::min_element(n_slots.begin(), n_slots.end());
+    const int s_max = *std::max_element(n_slots.begin(), n_slots.end());
+    return format(
+        "{\"expert_cache\": {\"slots_min\": %d, \"slots_max\": %d, \"slot_bytes\": %zu, \"expert_bytes\": %zu, "
+        "\"io_threads\": %d, \"prefetch_k\": %d, \"prefetch_half_life\": %d, \"prefetch_mix\": %g, \"file\": %s}, "
+        "\"prefill\": %s, \"decode\": %s, "
+        "\"process\": {\"disk_bytes_read\": %s, \"pageins\": %s, \"major_faults\": %s, \"max_phys_footprint\": %s}}",
+        s_min, s_max, slot_bytes(), expert_bytes.empty() ? (size_t) 0 : expert_bytes[0],
+        n_threads, markov ? prefetch_k : 0, prefetch_half_life, prefetch_mix, json_string(path).c_str(),
+        counts_json(slots->counts(false)).c_str(), counts_json(slots->counts(true)).c_str(),
+        json_u64(pc.has_io, pc.disk_read - disk_read0).c_str(), json_u64(pc.has_io, pc.pageins - pageins0).c_str(),
+        json_u64(pc.has_faults, pc.faults - faults0).c_str(), json_u64(pc.has_io, pc.max_phys_footprint).c_str());
+}
diff --git a/src/llama-expert-cache.h b/src/llama-expert-cache.h
new file mode 100644
index 000000000..ec772aeaf
--- /dev/null
+++ b/src/llama-expert-cache.h
@@ -0,0 +1,108 @@
+#pragma once
+
+// [EXPERIMENTAL] A bounded cache of routed experts (Kolibri only).
+//
+// The stacked expert tensors of every layer stay in the GGUF: they are mapped, but never touched.
+// Each layer instead has slot tensors of n_slots experts in device memory. Before the expert
+// matmuls of a ubatch, a CPU op maps the router's ids to slots, reading every expert that is not in
+// a slot with pread (F_NOCACHE on macOS, so the bytes do not stay in the page cache); the matmuls
+// then read the slots. The router chooses every expert: the expert weights keep its own ids, and a
+// prediction only ever decides what to read ahead.
+
+#include "llama.h"
+#include "llama-expert-slots.h"
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <atomic>
+#include <memory>
+#include <string>
+#include <vector>
+
+struct llama_expert_cache {
+    // the gate, up and down tensors of one layer, with their data offsets in the file
+    struct tensors {
+        ggml_tensor * t[3]    = {};
+        size_t        offs[3] = {};
+    };
+
+    // userdata of the remap op of one layer
+    struct layer_ud {
+        llama_expert_cache * cache;
+        int il;
+    };
+
+    llama_expert_cache(const llama_expert_cache_params & p, int n_layer, int n_expert, int n_expert_used);
+    ~llama_expert_cache();
+
+    // init takes the stacked expert tensors and their offsets in the file the loader opened as fd,
+    // allocates each layer's slots for that layer's device, opens the file for its own reads and
+    // starts the I/O threads; it throws on failure. The slots are host memory, which pread writes:
+    // a CPU buffer, or host memory the device uses in place (buffer_from_host_ptr, e.g. Metal).
+    void init(const std::vector<tensors> & stacked, const std::vector<ggml_backend_dev_t> & devs, int fd);
+
+    // the largest ubatch whose experts always fit: the fewest slots of a layer over n_expert_used
+    uint32_t max_ubatch() const;
+
+    // one context per model
+    bool attach();
+    void detach();
+    bool in_use() const { return attached; }
+
+    // the slot ids of the router's selected experts [n_expert_used, n_tokens], from a CPU op
+    ggml_tensor * build_remap(ggml_context * ctx, ggml_tensor * selected_experts, int il);
+
+    ggml_tensor * gate(int il) const { return slot_t[il].t[0]; }
+    ggml_tensor * up  (int il) const { return slot_t[il].t[1]; }
+    ggml_tensor * down(int il) const { return slot_t[il].t[2]; }
+
+    // the remap op's work
+    void remap(int il, const ggml_tensor * ids, ggml_tensor * dst);
+
+    std::string stats_json() const;
+
+private:
+    bool load(int il, int e, int s);
+
+    const int n_layer, n_expert, n_expert_used;
+    std::vector<int> n_slots; // per layer
+    int    n_threads;
+    int    prefetch_k;
+    int    prefetch_half_life;
+    double prefetch_mix;
+    std::string stats_path;
+
+    std::vector<tensors>  stacked;
+    std::vector<tensors>  slot_t; // the slot tensors; offs unused
+    std::vector<size_t>   expert_bytes; // per layer
+    std::vector<layer_ud> ud;
+
+    // the slots of the layers of one device
+    struct group {
+        ggml_backend_dev_t    dev  = nullptr;
+        ggml_context *        ctx  = nullptr;
+        ggml_backend_buffer_t buf  = nullptr;
+        void *                host = nullptr; // the mapping the device's buffer wraps, if any
+        size_t                size = 0;
+    };
+    std::vector<group> groups;
+    size_t slot_bytes() const;
+
+    std::string path;
+    int fd = -1;
+
+    std::unique_ptr<llama_expert_slots>  slots;
+    std::unique_ptr<llama_expert_markov> markov;
+    std::vector<int> pred;
+
+    std::atomic<bool> attached{false};
+    int64_t tok_first = 0; // the first token of the ubatch being computed
+    int64_t tok_next  = 0;
+    bool    decode    = false;
+
+    // process counters at init, for the deltas in the stats
+    uint64_t disk_read0 = 0;
+    uint64_t pageins0   = 0;
+    uint64_t faults0    = 0;
+};
diff --git a/src/llama-expert-slots.cpp b/src/llama-expert-slots.cpp
new file mode 100644
index 000000000..228bbbcfd
--- /dev/null
+++ b/src/llama-expert-slots.cpp
@@ -0,0 +1,406 @@
+#include "llama-expert-slots.h"
+
+#include <algorithm>
+#include <cassert>
+#include <chrono>
+#include <cmath>
+
+llama_expert_slots::llama_expert_slots(std::vector<int> n_slots, int n_expert, std::vector<size_t> expert_bytes, int n_threads, load_fn load)
+    : n_expert(n_expert), expert_bytes(std::move(expert_bytes)), load(std::move(load)), keep(n_expert, 0) {
+    assert(n_slots.size() == this->expert_bytes.size());
+    layers.resize(n_slots.size());
+    for (size_t l = 0; l < n_slots.size(); ++l) {
+        layers[l].slots.resize(std::max(n_slots[l], 0));
+        layers[l].where.assign(n_expert, -1);
+    }
+    for (int i = 0; i < std::max(n_threads, 1); ++i) {
+        threads.emplace_back([this] { worker(); });
+    }
+}
+
+llama_expert_slots::~llama_expert_slots() {
+    {
+        std::lock_guard<std::mutex> lock(mtx);
+        stop = true;
+        q_demand.clear();
+        q_prefetch.clear();
+    }
+    cv_work.notify_all();
+    for (auto & t : threads) {
+        t.join();
+    }
+}
+
+int llama_expert_slots::min_slots() const {
+    int m = layers.empty() ? 0 : (int) layers[0].slots.size();
+    for (const auto & L : layers) {
+        m = std::min(m, (int) L.slots.size());
+    }
+    return m;
+}
+
+int llama_expert_slots::slot_of(int l, int e) const {
+    std::lock_guard<std::mutex> lock(mtx);
+    return layers[l].where[e];
+}
+
+llama_expert_cache_counts llama_expert_slots::counts(bool decode) const {
+    std::lock_guard<std::mutex> lock(mtx);
+    return decode ? c_decode : c_prefill;
+}
+
+bool llama_expert_slots::failure(int & l, int & e) const {
+    std::lock_guard<std::mutex> lock(mtx);
+    l = failed_layer;
+    e = failed_expert;
+    return demand_failed;
+}
+
+void llama_expert_slots::drain() {
+    std::unique_lock<std::mutex> lock(mtx);
+    cv_done.wait(lock, [this] { return q_demand.empty() && q_prefetch.empty() && running == 0; });
+}
+
+// an empty slot, else the least recently used ready slot whose expert the running remap does not
+// need; never a slot that is loading
+int llama_expert_slots::pick_victim(int l) const {
+    const auto & L = layers[l];
+    int best = -1;
+    for (int s = 0; s < (int) L.slots.size(); ++s) {
+        const slot & x = L.slots[s];
+        if (x.state == EMPTY) {
+            return s;
+        }
+        if (x.state == READY && !keep[x.expert] && (best < 0 || x.last_use < L.slots[best].last_use)) {
+            best = s;
+        }
+    }
+    return best;
+}
+
+// the caller holds the lock; slot s of layer l is empty or ready and no longer mapped
+void llama_expert_slots::assign(int l, int s, int e, bool demand, bool decode) {
+    slot & x = layers[l].slots[s];
+    x.expert       = e;
+    x.state        = LOADING;
+    x.last_use     = tick;
+    x.prefetched   = !demand;
+    x.queued       = true;
+    x.demand       = demand;
+    x.phase_decode = decode;
+    layers[l].where[e] = s;
+    (demand ? q_demand : q_prefetch).push_back({l, s});
+}
+
+bool llama_expert_slots::remap(int l, const int32_t * ids, int n, bool decode, int32_t * out) {
+    std::unique_lock<std::mutex> lock(mtx);
+    auto & L = layers[l];
+
+    for (int i = 0; i < n; ++i) {
+        if (ids[i] < 0 || ids[i] >= n_expert) {
+            return false;
+        }
+    }
+    needed.clear();
+    for (int i = 0; i < n; ++i) {
+        const int e = ids[i];
+        if (!keep[e]) {
+            keep[e] = 1;
+            needed.push_back(e);
+        }
+    }
+    auto release = [&] {
+        for (int e : needed) {
+            keep[e] = 0;
+        }
+    };
+    if (needed.size() > L.slots.size()) {
+        release();
+        return false;
+    }
+
+    in_flight = l;
+    tick++;
+    auto & c = counts_of(decode);
+    c.steps++;
+    c.needed += needed.size();
+
+    // queued prefetches of this layer that it does not need are dropped: their slots are free again
+    for (auto it = q_prefetch.begin(); it != q_prefetch.end();) {
+        slot & x = layers[it->l].slots[it->slot];
+        if (it->l == l && !keep[x.expert]) {
+            counts_of(x.phase_decode).prefetch_cancelled++;
+            L.where[x.expert] = -1;
+            x = slot{};
+            it = q_prefetch.erase(it);
+        } else {
+            ++it;
+        }
+    }
+
+    // hits; a queued prefetch of a needed expert moves to the demand queue
+    for (int e : needed) {
+        const int s = L.where[e];
+        if (s < 0) {
+            continue;
+        }
+        slot & x = L.slots[s];
+        if (x.state == READY) {
+            c.hits++;
+        } else {
+            c.hits_loading++;
+            if (x.queued && !x.demand) {
+                for (auto it = q_prefetch.begin(); it != q_prefetch.end(); ++it) {
+                    if (it->l == l && it->slot == s) {
+                        q_prefetch.erase(it);
+                        q_demand.push_front({l, s});
+                        break;
+                    }
+                }
+            }
+        }
+        if (x.prefetched) {
+            counts_of(x.phase_decode).prefetch_used++;
+            x.prefetched = false;
+        }
+        x.last_use = tick;
+    }
+
+    // misses go to the least recently used slots the ubatch does not need; when every such slot
+    // is loading, the remap waits for one of those loads
+    auto load_missing = [&] {
+        for (int e : needed) {
+            if (L.where[e] >= 0) {
+                continue;
+            }
+            int s;
+            while ((s = pick_victim(l)) < 0) {
+                cv_done.wait(lock);
+            }
+            slot & x = L.slots[s];
+            if (x.state == READY) {
+                c.evictions++;
+                if (x.prefetched) {
+                    counts_of(x.phase_decode).prefetch_wasted++;
+                }
+                L.where[x.expert] = -1;
+            }
+            c.misses++;
+            assign(l, s, e, true, decode);
+        }
+        cv_work.notify_all();
+    };
+    load_missing();
+
+    const auto t0 = std::chrono::steady_clock::now();
+    bool ok = true;
+    for (;;) {
+        if (demand_failed) {
+            ok = false;
+            break;
+        }
+        bool pending = false;
+        bool lost    = false; // a prefetch of a needed expert failed: load it on demand
+        for (int e : needed) {
+            const int s = L.where[e];
+            if (s < 0) {
+                lost = true;
+            } else if (L.slots[s].state != READY) {
+                pending = true;
+            }
+        }
+        if (lost) {
+            load_missing();
+            continue;
+        }
+        if (!pending) {
+            break;
+        }
+        cv_done.wait(lock);
+    }
+    c.wait_seconds += std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+
+    if (ok) {
+        for (int i = 0; i < n; ++i) {
+            out[i] = L.where[ids[i]];
+        }
+    }
+    release();
+    return ok;
+}
+
+void llama_expert_slots::prefetch(int l, const int * experts, int n, bool decode) {
+    std::lock_guard<std::mutex> lock(mtx);
+    auto & L = layers[l];
+    auto & c = counts_of(decode);
+    if (l == in_flight) {
+        c.prefetch_skipped += n;
+        return;
+    }
+    for (int i = 0; i < n; ++i) {
+        const int e = experts[i];
+        if (L.where[e] >= 0) {
+            c.prefetch_skipped++;
+            continue;
+        }
+        const int s = pick_victim(l);
+        if (s < 0) {
+            c.prefetch_skipped++;
+            continue;
+        }
+        slot & x = L.slots[s];
+        if (x.state == READY) {
+            c.evictions++;
+            if (x.prefetched) {
+                counts_of(x.phase_decode).prefetch_wasted++;
+            }
+            L.where[x.expert] = -1;
+        }
+        c.prefetch_issued++;
+        assign(l, s, e, false, decode);
+    }
+    cv_work.notify_all();
+}
+
+void llama_expert_slots::worker() {
+    std::unique_lock<std::mutex> lock(mtx);
+    for (;;) {
+        cv_work.wait(lock, [this] { return stop || !q_demand.empty() || !q_prefetch.empty(); });
+        if (stop) {
+            return;
+        }
+        auto & q = q_demand.empty() ? q_prefetch : q_demand;
+        const job j = q.front();
+        q.pop_front();
+
+        slot & x = layers[j.l].slots[j.slot];
+        x.queued = false;
+        const int  e      = x.expert;
+        const bool demand = x.demand;
+        const bool decode = x.phase_decode;
+        running++;
+
+        // the slot is loading and in no queue: no remap, prefetch or cancellation touches it now
+        lock.unlock();
+        const auto t0 = std::chrono::steady_clock::now();
+        const bool ok = load(j.l, e, j.slot);
+        const double dt = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+        lock.lock();
+
+        running--;
+        auto & c = counts_of(decode);
+        c.io_seconds += dt;
+        if (!demand) {
+            c.io_prefetch_seconds += dt;
+        }
+        if (ok) {
+            x.state = READY;
+            (demand ? c.demand_bytes : c.prefetch_bytes) += expert_bytes[j.l];
+        } else {
+            c.load_failures++;
+            layers[j.l].where[e] = -1;
+            x = slot{};
+            if (demand) {
+                demand_failed = true;
+                failed_layer  = j.l;
+                failed_expert = e;
+            }
+        }
+        cv_done.notify_all();
+    }
+}
+
+void llama_expert_top_k(const std::vector<double> & score, int k, std::vector<int> & out) {
+    out.clear();
+    for (int b = 0; b < (int) score.size(); ++b) {
+        const double v = score[b];
+        if ((int) out.size() < k) {
+            out.push_back(b);
+        } else if (!(v > score[out[k-1]])) {
+            continue;
+        }
+        int i = (int) out.size() - 1;
+        while (i > 0 && score[out[i-1]] < v) {
+            out[i] = out[i-1];
+            i--;
+        }
+        out[i] = b;
+    }
+}
+
+llama_expert_markov::llama_expert_markov(int n_layer, int n_expert, int half_life, double mix)
+    : n_layer(n_layer), n_expert(n_expert), half_life(std::max(half_life, 1)), mix(mix),
+      freq((size_t) n_layer*n_expert), sum(n_layer), seen(n_layer, 0),
+      cross((size_t) n_layer*n_expert*n_expert), x_row((size_t) n_layer*n_expert),
+      last(n_layer), last_tok(n_layer, -1), score(n_expert) {}
+
+size_t llama_expert_markov::bytes() const {
+    return cross.size()*sizeof(float) + x_row.size()*sizeof(float) + freq.size()*sizeof(double) + sum.size()*sizeof(double);
+}
+
+void llama_expert_markov::observe(int l, int64_t first, bool decode, const int * ids, int n) {
+    const size_t N = n_expert;
+    if (const int64_t d = first - seen[l]; d > 0) {
+        const double f = std::pow(0.5, double(d)/double(half_life));
+        for (size_t e = 0; e < N; ++e) {
+            freq[l*N + e] *= f;
+        }
+        sum[l] *= f;
+        seen[l] = first;
+    }
+    for (int i = 0; i < n; ++i) {
+        freq[l*N + ids[i]]++;
+    }
+    sum[l] += double(n);
+    if (!decode) {
+        last_tok[l] = -1;
+        return;
+    }
+    if (l >= 2 && last_tok[l-2] == first) {
+        for (int a : last[l-2]) {
+            float * r = &cross[(l*N + a)*N];
+            for (int i = 0; i < n; ++i) {
+                r[ids[i]]++;
+            }
+            x_row[l*N + a] += float(n);
+        }
+    }
+    last[l].assign(ids, ids + n);
+    last_tok[l] = first;
+}
+
+int llama_expert_markov::predict(int l, int64_t first, bool decode, int k, std::vector<int> & out) {
+    out.clear();
+    if (!decode || k <= 0) {
+        return -1;
+    }
+    const int target = l + 1;
+    const int from   = l - 1;
+    if (l < 1 || target >= n_layer || last_tok[from] != first) {
+        return -1;
+    }
+    const size_t N = n_expert;
+    std::fill(score.begin(), score.end(), 0.0);
+    double den = 0;
+    for (int a : last[from]) {
+        den += double(x_row[target*N + a]);
+    }
+    if (den > 0 && mix > 0) {
+        for (int a : last[from]) {
+            const float * r = &cross[(target*N + a)*N];
+            for (size_t b = 0; b < N; ++b) {
+                score[b] += double(r[b]);
+            }
+        }
+        for (size_t b = 0; b < N; ++b) {
+            score[b] *= mix / den;
+        }
+    }
+    if (const double s = sum[target]; s > 0 && mix < 1) {
+        for (size_t b = 0; b < N; ++b) {
+            score[b] += (1 - mix) * freq[target*N + b] / s;
+        }
+    }
+    llama_expert_top_k(score, std::min(k, n_expert), out);
+    return target;
+}
