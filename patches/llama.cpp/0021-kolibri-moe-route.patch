+#include "moe-route.h"
 
 #include <algorithm>
 #include <array>
@@ -2023,6 +2024,16 @@ int llama_perplexity(int argc, char ** argv) {
     llama_backend_init();
     llama_numa_init(params.numa);
 
+    moe_route route;
+    if (!route.init(n_ctx, params.n_batch, params.n_ubatch, params.kv_unified)) {
+        return 1;
+    }
+    if (route.active()) {
+        params.cb_eval = moe_route::cb;
+        params.cb_eval_user_data = &route;
+        params.warmup = false;
+    }
+
     // load the model and apply lora adapter, if any
     auto llama_init = common_init_from_params(params);
 
@@ -2065,6 +2076,8 @@ int llama_perplexity(int argc, char ** argv) {
         results = perplexity(ctx, params, n_ctx);
     }
 
+    route.finish();
+
     LOG("\n");
     llama_perf_context_print(ctx);
     common_memory_breakdown_print(ctx);
