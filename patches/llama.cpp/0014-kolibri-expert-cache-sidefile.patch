+        fd2 = open(x.gguf_path.c_str(), O_RDONLY);
+        const std::string msg = refusal(x, fd2);
+        CHECK(msg.find("cannot open") != std::string::npos && msg.find("no fallback") != std::string::npos);
+        close(fd2);
+    }
+}
