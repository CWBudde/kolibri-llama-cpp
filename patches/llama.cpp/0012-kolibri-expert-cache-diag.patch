+void llama_decode_diag::add(double seconds, uint64_t n_splits, uint64_t n_commits) {
+    std::lock_guard<std::mutex> lock(mtx);
+    tokens++;
+    wall_seconds  += seconds;
+    splits        += n_splits;
+    metal_commits += n_commits;
