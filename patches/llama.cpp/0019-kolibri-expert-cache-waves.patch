+int llama_expert_slots::plan_waves(int l, const int32_t * ids, int n, int k, int cap, int n_built) {
+    std::lock_guard<std::mutex> lock(mtx);
+    auto & L = layers[l];
+    if (k <= 0 || cap < k) {
+        return -1;
+    }
+    for (int i = 0; i < n; ++i) {
+        if (ids[i] < 0 || ids[i] >= n_expert) {
+            return -1;
+        }
