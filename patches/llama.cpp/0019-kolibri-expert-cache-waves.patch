+        }
+        if (lost) {
+            load_missing();
+            cv_work.notify_all();
+            continue;
+        }
+        if (!pending) {
+            break;
+        }
+        wait_load(lock, budget);
+    }
+    c.wait_seconds += std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    if (!ok) {
+        release();
+        return false;
+    }
+    c.waves_built++;
+    if (!cur.empty()) {
+        c.waves++;
+    }
