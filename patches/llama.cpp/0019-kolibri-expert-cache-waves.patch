+    std::vector<int> uniq;
+    for (int i = 0; i < n; ++i) {
+        if (uses[ids[i]]++ == 0) {
+            uniq.push_back(ids[i]);
+        }
+    }
+    // waves of cap experts, larger only if a union would otherwise take more waves than the graph holds
+    const int size = n_built > 0 ? std::max(cap, ((int) uniq.size() + n_built - 1)/n_built) : cap;
